{
  "name": "mkdocs-exam",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "check": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:css": "stylelint \"mkdocs_exam/css/**/*.css\"",
    "typecheck": "bunx tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:minify": "esbuild mkdocs_exam/js/exam.js --minify --outfile=mkdocs_exam/js/exam.min.js && esbuild mkdocs_exam/css/exam.css --minify --outfile=mkdocs_exam/css/exam.min.css"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@go-task/cli": "^3.45.5",
    "@types/bun": "latest",
    "dprint": "^0.50.2",
    "esbuild": "^0.24.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "vitest": "^2.1.8",
    "happy-dom": "^15.11.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.2"
}
